+
+/*
+ * boost::filesystem::fstream with a 256 KiB buffer (the extracted files are
+ * written through it, in order): the default (a few KiB) makes a write of the
+ * system for every few KiB, each a round trip to another thread where files
+ * are a browser's storage. A base class before the stream's, so that it
+ * outlives the stream's last flush.
+ */
+struct write_buffer {
+	enum { size = 1 << 18 };
+	char * buffer_;
+	write_buffer() : buffer_(new char[size]) { }
+	~write_buffer() { delete[] buffer_; }
+private:
+	write_buffer(const write_buffer &);
+	write_buffer & operator=(const write_buffer &);
+};
+class fstream : private write_buffer, public boost::filesystem::fstream {
+	
+public:
+	
+	fstream() { }
+	
+	explicit fstream(const boost::filesystem::path & p,
+	                 std::ios_base::openmode mode = std::ios_base::in | std::ios_base::out) {
+		open(p, mode);
+	}
+	
+	void open(const boost::filesystem::path & p,
+	          std::ios_base::openmode mode = std::ios_base::in | std::ios_base::out) {
+		rdbuf()->pubsetbuf(buffer_, write_buffer::size);
+		boost::filesystem::fstream::open(p, mode);
+	}
+	
+};
 
