 // PumpHostEvents hands it every event instead of turning them into
 // window messages (input filtering for background runs still applies).
 void SetHostEventSink(void (*sink)(const SDL_Event&));
+// The gamepad as the mouse (left stick, A, B; the shortcut keys): the pointer's speed (1: the
+// default, 1100 points a second at full tilt on a 1280-wide window), and a hook that gets its mouse
+// and key events before the game; true: taken (the game does not get it). Apps put their own
+// controls over the game (native buttons, panels) that a pad's clicks otherwise never reach.
+void SetPadPointerSpeed(float factor);
+void SetPadEventHook(bool (*hook)(const SDL_Event&));
+// The right stick (the arrow keys held, with Ctrl: scrolls maps): below 1, held only that share of
+// the time (slower).
+void SetPadScrollSpeed(float factor);
+// Off: the gamepad is not read at all (on at first).
+void SetPadEnabled(bool on);
+// What a gamepad button does: a mouse button (SDL_BUTTON_*, at the pointer), or a key (with `mod`
+// held around it), held while the button is; none of them: nothing. A, B, X and Y by their labels.
+enum class PadButton { A, B, X, Y, L, R, ZL, ZR, Up, Down, Left, Right, Plus, Minus, LStick, RStick, Count };
+struct PadAction {
+  uint8_t mouse = 0;
+  SDL_Scancode key = SDL_SCANCODE_UNKNOWN;
+  SDL_Scancode mod = SDL_SCANCODE_UNKNOWN;
+};
+void SetPadAction(PadButton b, PadAction a);
 
