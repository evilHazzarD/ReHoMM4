 // Backend selection and presentation geometry for gfx::Device.
 
+#include <algorithm>
+#include <cmath>
 #include "runtime/gfx/device.h"
 
 #include <mutex>
 
 namespace recomp::gfx {
 
+Rect FitRectIn(int src_w, int src_h, int dst_w, int dst_h);
+
 namespace {
 std::mutex g_present_mu;
 Presentation g_present{};
+View g_view{};  // under g_present_mu
 }  // namespace
 
+float g_inset_l = 0, g_inset_r = 0;
+
+void SetOutputInsets(float left, float right) {
+  g_inset_l = std::clamp(left, 0.0f, 0.25f);
+  g_inset_r = std::clamp(right, 0.0f, 0.25f);
+}
+
+void OutputInsets(float* left, float* right) {
+  *left = g_inset_l;
+  *right = g_inset_r;
+}
+
 Rect FitRect(int src_w, int src_h, int dst_w, int dst_h) {
+  if (dst_w > 0 && (g_inset_l > 0 || g_inset_r > 0)) {
+    const int l = int(std::lround(g_inset_l * dst_w)), r = int(std::lround(g_inset_r * dst_w));
+    Rect in = FitRectIn(src_w, src_h, dst_w - l - r, dst_h);
+    in.left += l;
+    in.right += l;
+    return in;
+  }
+  return FitRectIn(src_w, src_h, dst_w, dst_h);
+}
+
+Rect FitRectIn(int src_w, int src_h, int dst_w, int dst_h) {
   if (src_w <= 0 || src_h <= 0 || dst_w <= 0 || dst_h <= 0) return {0, 0, dst_w, dst_h};
   int64_t w = dst_w, h = dst_h;
   if (int64_t(dst_w) * src_h > int64_t(dst_h) * src_w)
@@ -22,11 +50,85 @@ Rect FitRect(int src_w, int src_h, int dst_w, int dst_h) {
   return {x, y, x + int(w), y + int(h)};
 }
 
+void SetView(const View& v) {
+  View c = v;
+  c.w = std::clamp(c.w, 0.05f, 1.0f);
+  c.h = std::clamp(c.h, 0.05f, 1.0f);
+  c.x = std::clamp(c.x, 0.0f, 1.0f - c.w);
+  c.y = std::clamp(c.y, 0.0f, 1.0f - c.h);
+  std::lock_guard<std::mutex> l(g_present_mu);
+  g_view = c;
+}
+
+View GetView() {
+  std::lock_guard<std::mutex> l(g_present_mu);
+  return g_view;
+}
+
+RectF ZoomedRect(const Rect& r) {
+  const View v = GetView();
+  const float w = float(r.right - r.left) / v.w, h = float(r.bottom - r.top) / v.h;
+  const float l = float(r.left) - v.x * w, t = float(r.top) - v.y * h;
+  return {l, t, l + w, t + h};
+}
+
 void NotePresentation(const Presentation& p) {
   std::lock_guard<std::mutex> l(g_present_mu);
   g_present = p;
 }
 
+namespace present_state {
