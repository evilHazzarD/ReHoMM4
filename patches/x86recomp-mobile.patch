+}
+}  // namespace present_state
+
+void SetPresentOverlays(std::vector<PresentOverlay> overlays) {
+  std::lock_guard<std::mutex> l(present_state::OverlayMutex());
+  present_state::Overlays() = std::move(overlays);
+  present_state::OverlayGen()++;
+}
+
+namespace {
+void SetPicture(int i, const uint32_t* argb, int w, int h) {
+  std::lock_guard<std::mutex> l(present_state::PictureMutex());
+  present_state::PresentPicture& p = present_state::Pictures()[i];
+  p.image.assign(argb, argb + size_t(w > 0 ? w : 0) * size_t(h > 0 ? h : 0));
+  p.iw = w;
+  p.ih = h;
+  p.gen++;
+}
+void SetPicturePos(int i, int x, int y, bool shown) {
+  std::lock_guard<std::mutex> l(present_state::PictureMutex());
+  present_state::PresentPicture& p = present_state::Pictures()[i];
+  p.x = x;
+  p.y = y;
