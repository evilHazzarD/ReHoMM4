+# recomp_link_hle(<target> <libs...>): links runtime/HLE libraries; where
+# they are static (mobile), whole, so their registrars are kept.
+function(recomp_link_hle target)
+  foreach(_lib ${ARGN})
+    if(RECOMP_LIB_TYPE STREQUAL "STATIC")
+      target_link_libraries(${target} PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,${_lib}>")
+    else()
+      target_link_libraries(${target} PRIVATE ${_lib})
+    endif()
+  endforeach()
+endfunction()
 
