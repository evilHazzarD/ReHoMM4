 // after anything that changes a window's placement, visibility or mode,
 // or the screen size. Leaving it gives the host window the client size
 // again.
+// A window the player can resize: the frame is scaled to the window as in fullscreen, so it keeps
+// the client's aspect (no bars).
+void MakeResizable(SDL_Window* sdl, int cw, int ch) {
+  if (cw > 0 && ch > 0) {
+    const float aspect = float(cw) / float(ch);
+    SDL_SetWindowAspectRatio(sdl, aspect, aspect);
+  }
+  SDL_SetWindowResizable(sdl, true);
+}
