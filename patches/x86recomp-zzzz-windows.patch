--- /dev/null
+++ b/src/sys/mman.h
@@ -0,0 +1,63 @@
+// Small POSIX mmap facade for the Windows build of x86recomp.  It covers the
+// anonymous reservation/commit/protection paths used by the guest arena and
+// host stacks.  File mappings deliberately remain unsupported for now: their
+// Win32 implementation belongs in kernel32_sync.cpp.
+#pragma once
+
+#if !defined(_WIN32)
+// This path is also searched by the native host build used for lifting.
+// Keep the shim transparent there instead of shadowing the system header.
+#include_next <sys/mman.h>
+#else
+
+#include <windows.h>
+#include <cstddef>
+#include <cstdint>
+
+#define PROT_NONE 0x0
+#define PROT_READ 0x1
+#define PROT_WRITE 0x2
+#define PROT_EXEC 0x4
+#define MAP_SHARED 0x01
+#define MAP_PRIVATE 0x02
+#define MAP_FIXED 0x10
+#define MAP_ANONYMOUS 0x20
+#define MAP_NORESERVE 0x4000
+#define MAP_FIXED_NOREPLACE 0x100000
+#define MAP_FAILED reinterpret_cast<void*>(intptr_t(-1))
+
+inline DWORD recomp_win_prot(int p) {
+  if (p == PROT_NONE) return PAGE_NOACCESS;
+  if ((p & (PROT_READ | PROT_WRITE | PROT_EXEC)) == (PROT_READ | PROT_WRITE | PROT_EXEC)) return PAGE_EXECUTE_READWRITE;
+  if ((p & (PROT_READ | PROT_EXEC)) == (PROT_READ | PROT_EXEC)) return PAGE_EXECUTE_READ;
+  if (p & PROT_WRITE) return PAGE_READWRITE;
+  if (p & PROT_READ) return PAGE_READONLY;
+  return PAGE_NOACCESS;
+}
+
+inline void* mmap(void* addr, size_t length, int prot, int flags, int fd, intptr_t) {
+  (void)fd;
+  if (!(flags & MAP_ANONYMOUS)) return MAP_FAILED;
+  const DWORD protect = recomp_win_prot(prot);
+  if (flags & MAP_FIXED) {
+    // A fixed remap replaces an earlier reservation, as mmap(MAP_FIXED) does.
+    VirtualFree(addr, 0, MEM_RELEASE);
+    return VirtualAlloc(addr, length, MEM_RESERVE | MEM_COMMIT, protect) ?: MAP_FAILED;
+  }
+  const DWORD kind = prot == PROT_NONE ? MEM_RESERVE : (MEM_RESERVE | MEM_COMMIT);
+  void* p = VirtualAlloc(addr, length, kind, protect);
+  if (!p && (flags & MAP_FIXED_NOREPLACE)) return MAP_FAILED;
+  if (!p && addr) p = VirtualAlloc(nullptr, length, kind, protect);
+  return p ? p : MAP_FAILED;
+}
+
+inline int mprotect(void* addr, size_t length, int prot) {
+  DWORD old = 0;
+  if (VirtualProtect(addr, length, recomp_win_prot(prot), &old)) return 0;
+  // A reserved arena becomes committed on its first accessible mapping.
+  if (VirtualAlloc(addr, length, MEM_COMMIT, recomp_win_prot(prot))) return 0;
+  return -1;
+}
+
+inline int munmap(void* addr, size_t) { return VirtualFree(addr, 0, MEM_RELEASE) ? 0 : -1; }
+#endif
