+bool WildcardMatch(const char* pattern, const char* text) {
+  // FindFirstFile uses DOS wildcards; the game's file scans need only * and
+  // ?.  Inputs are already lower-cased at the call site.
+  while (*pattern) {
+    if (*pattern == '*') {
+      while (*++pattern == '*') {}
+      if (!*pattern) return true;
+      while (*text) {
+        if (WildcardMatch(pattern, text++)) return true;
+      }
+      return false;
+    }
+    if (!*text || (*pattern != '?' && *pattern != *text)) return false;
+    ++pattern;
+    ++text;
+  }
+  return !*text;
+}
