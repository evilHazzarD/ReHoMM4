# The app's own words in the game's languages (src/ui_text.h): every h4/ui_text/<code>.json, built
# into the app as ui_text_files.inc (a byte array per file and the table of them). A new language is
# a new file there: CMake runs again when one is added, removed or changed.
#
#   h4_ui_text(<target>)   ui_text.cpp of <target> includes it (from the build folder)
function(h4_ui_text target)
  set(dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../ui_text")
  file(GLOB files CONFIGURE_DEPENDS "${dir}/*.json")
  list(SORT files)
  if(NOT files)
    message(FATAL_ERROR "no ${dir}/*.json")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${files})
  set(arrays "")
  set(table "")
  foreach(f IN LISTS files)
    get_filename_component(code "${f}" NAME_WE)
    string(MAKE_C_IDENTIFIER "${code}" id)
    file(READ "${f}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND arrays "static const unsigned char kUiText_${id}[] = {${hex}0};\n")
    string(APPEND table "    {\"${code}\", reinterpret_cast<const char*>(kUiText_${id}), sizeof kUiText_${id} - 1},\n")
  endforeach()
  set(inc "${CMAKE_CURRENT_BINARY_DIR}/ui_text_files.inc")
  set(text "// Made by h4/cmake/ui_text.cmake from h4/ui_text/*.json: do not edit.\n${arrays}\nconst UiTextFile kUiTextFiles[] = {\n${table}};\n")
  file(CONFIGURE OUTPUT "${inc}" CONTENT "${text}" @ONLY)  # (rewritten only when it changes)
  target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
  get_target_property(sources ${target} SOURCES)
  foreach(s IN LISTS sources)
    if(s MATCHES "ui_text\\.cpp$")
      set_property(SOURCE "${s}" TARGET_DIRECTORY ${target} APPEND PROPERTY OBJECT_DEPENDS "${inc}")
    endif()
  endforeach()
endfunction()
