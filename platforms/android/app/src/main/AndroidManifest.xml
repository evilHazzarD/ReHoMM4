<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <!-- Android TV: shown in its launcher (the banner, LEANBACK_LAUNCHER), played with a gamepad. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- SDL_GPU draws with Vulkan. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003"
        android:required="true" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The in-app installer: GOG sign-in and download. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="false"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true">
        <!-- simpleperf / Android Studio profiler on this release build (adb only, no debugger). -->
        <profileable android:shell="true" />
        <activity android:name=".HeroesActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="fullUser"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The app's files (the game, the saves) as a place of the Files app: FilesProvider.java. -->
        <provider
            android:name=".FilesProvider"
            android:authorities="games.hazzard.heroes4.files"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- Relaunches the game in a fresh process (a new language): RestartActivity.java. -->
        <activity
            android:name=".RestartActivity"
            android:process=":restart"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />
    </application>
</manifest>
