{
  "name": "ReHoMM4: Heroes of Might and Magic IV",
  "short_name": "ReHoMM4",
  "description": "Heroes of Might and Magic IV from your own GOG copy, in the browser.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
