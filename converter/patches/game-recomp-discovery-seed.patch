 pub use engine::{Options, Source};
 pub use image::{Image, Section};
 
+use std::cell::RefCell;
 use std::collections::{BTreeSet, HashSet};
 
+thread_local! {
+    static PROGRESS: RefCell<Option<Box<dyn FnMut(Stage, usize, usize)>>> = const { RefCell::new(None) };
+}
+
+/// The steps of a discovery round, for a progress bar.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Stage {
+    /// Decoding: the instructions so far (no total).
+    Decode,
+    /// The function bodies (again for each no-return fixed-point step).
+    Bodies,
+    /// The code map: its functions, then its instructions.
+    MapFunctions,
+    MapInsns,
+}
+
+/// Runs `f` with `hook` told, now and then, where the discovery on this thread is: a stage, how
+/// much of it is done and of how much.
+pub fn with_progress<R>(hook: Box<dyn FnMut(Stage, usize, usize)>, f: impl FnOnce() -> R) -> R {
+    PROGRESS.with(|p| *p.borrow_mut() = Some(hook));
+    let r = f();
+    PROGRESS.with(|p| *p.borrow_mut() = None);
+    r
+}
+
+pub(crate) fn report_progress(stage: Stage, done: usize, total: usize) {
+    PROGRESS.with(|p| {
+        if let Some(hook) = p.borrow_mut().as_mut() {
+            hook(stage, done, total);
+        }
+    });
+}
